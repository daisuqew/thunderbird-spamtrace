{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "author": "Dais Watan",
  "default_locale": "en",
  "browser_specific_settings": { "gecko": { "id": "spam-trace@itinfusion.jp", "strict_min_version": "128.0" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "64": "icons/icon64.png" },
  "permissions": [ "messagesRead", "messagesUpdate", "accountsRead", "storage", "downloads" ],
  "optional_permissions": [ "<all_urls>", "https://ipwho.is/*", "https://check.torproject.org/*" ],
  "background": { "scripts": [ "i18n.js","parser.js","links.js","geodata.js","geolocal.js","geo.js","asn.js","risk.js","stats.js","brands.js","learn.js","logger.js","background.js" ] },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "message_display_action": { "default_title": "__MSG_extName__", "default_popup": "popup.html", "default_icon": { "32": "icons/icon32.png" } }
}
