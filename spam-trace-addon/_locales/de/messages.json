  "welcomeTitle": {
    "message": "Spam Trace ist installiert"
  },
  "welcomeIntro": {
    "message": "Verfolge die Herkunft von Spam-E-Mails auf einer Karte. Spam Trace analysiert die Kopfzeilen, schätzt das Spam-/Phishing-Risiko und zeigt Gründe und Zustellroute – standardmäßig offline."
  },
  "welcomePrivacyHead": {
    "message": "Zur Berechtigung „E-Mails lesen“"
  },
  "welcomePrivacy": {
    "message": "Thunderbird zeigt diese Berechtigung für jedes Add-on, das E-Mails lesen kann. Spam Trace analysiert die Kopfzeilen und liest den Textkörper nur, um Links zu prüfen (Phishing) und einen Hash zu berechnen. Betreff und Nachrichtentext werden nie gespeichert oder gesendet – lokal bleiben nur Hashes."
  },
  "welcomeOffline": {
    "message": "Online-Abfragen (detaillierte Geolokalisierung, Tor-Prüfung, Statistik-Upload) sind standardmäßig aus. Jede fragt beim Aktivieren in den Optionen ihre eigene Berechtigung ab."
  },
  "welcomeOpenOptions": {
    "message": "Einstellungen öffnen"
  },
  "welcomeTag": {
    "message": "E-Mail-Header-Analyse · standardmäßig offline"
  },
  "welcomeUseHead": {
    "message": "Verwendung"
  },
  "welcomeUse1": {
    "message": "Öffnen Sie eine Nachricht und klicken Sie in der Nachrichten-Symbolleiste auf die Schaltfläche Spam Trace, um Risikobewertung, Gründe und die Zustellroute zu sehen."
  },
  "welcomeUse2": {
    "message": "Klicken Sie auf „Verdächtige E-Mail“ (setzt auch die Junk-Markierung) oder „Legitim“ – Spam Trace lernt aus Ihrem Feedback und verfeinert künftige Bewertungen."
  },
  "welcomeUse3": {
    "message": "Bei risikoreichen Nachrichten kann automatisch ein Warnfenster erscheinen (Schwelle in den Einstellungen)."
  },
  "welcomeAnalyzeHead": {
    "message": "Was geprüft wird"
  },
  "welcomeAnalyze": {
    "message": "Die Received-Route und Absender-IP/ASN/Land, SPF/DKIM/DMARC-Authentifizierung, Links im Text (Absender- vs. Link-Domain) und Muster von Markenimitation – zusammengefasst als 0–100-Bewertung mit Gründen und Routenkarte."
  },
  "welcomeOnlineHead": {
    "message": "Online-Funktionen sind optional"
  },
  "welcomeData": {
    "message": "IP-zu-Land nutzt eine mitgelieferte DB-IP-Datenbank (CC BY 4.0); die Weltkarte nutzt Natural Earth (gemeinfrei). Beide sind im Add-on enthalten und werden offline verwendet. Die Oberfläche gibt es auf Englisch, Japanisch, Chinesisch (vereinfacht), Spanisch, Deutsch und Französisch."
  },
  "optHelp": {
    "message": "Erste Schritte / Hilfe"
  }
