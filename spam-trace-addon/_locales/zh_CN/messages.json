  "welcomeTitle": {
    "message": "Spam Trace 已安装"
  },
  "welcomeIntro": {
    "message": "在地图上追踪垃圾邮件的来源。Spam Trace 分析邮件头以评估垃圾/钓鱼风险，显示判定理由和发送路径，默认完全离线。"
  },
  "welcomePrivacyHead": {
    "message": "关于“读取邮件”权限"
  },
  "welcomePrivacy": {
    "message": "对任何能读取邮件的扩展，Thunderbird 都会显示此权限。Spam Trace 分析邮件头，仅为检查链接(钓鱼判定)和计算哈希而读取正文。邮件主题和正文文本绝不存储或发送，本地仅保留哈希值。"
  },
  "welcomeOffline": {
    "message": "在线查询(详细地理定位、Tor 检查、统计上传)默认关闭。在选项中启用时会分别请求权限。"
  },
  "welcomeOpenOptions": {
    "message": "打开设置"
  },
  "welcomeTag": {
    "message": "邮件头分析 · 默认离线"
  },
  "welcomeUseHead": {
    "message": "使用方法"
  },
  "welcomeUse1": {
    "message": "打开一封邮件，然后点击邮件工具栏中的 Spam Trace 按钮，即可查看风险评分、判定理由和发送路径地图。"
  },
  "welcomeUse2": {
    "message": "点击“可疑邮件”(同时会设置 Thunderbird 的垃圾邮件标记)或“正常邮件”——Spam Trace 会根据你的反馈优化后续评分。"
  },
  "welcomeUse3": {
    "message": "高风险邮件可自动弹出提醒窗口(阈值可在设置中调整)。"
  },
  "welcomeAnalyzeHead": {
    "message": "检查内容"
  },
  "welcomeAnalyze": {
    "message": "分析 Received 路径与发件人 IP/ASN/国家、SPF/DKIM/DMARC 认证、正文中的链接(比较发件域名与链接域名)以及品牌仿冒特征，汇总为 0–100 分,并附理由和路径地图。"
  },
  "welcomeOnlineHead": {
    "message": "在线功能为可选"
  },
  "welcomeData": {
    "message": "IP→国家使用内置的 DB-IP 数据库(CC BY 4.0);世界地图使用 Natural Earth(公有领域)。二者均内置于扩展并离线使用。界面支持英语、日语、简体中文、西班牙语、德语和法语。"
  },
  "optHelp": {
    "message": "入门 / 帮助"
