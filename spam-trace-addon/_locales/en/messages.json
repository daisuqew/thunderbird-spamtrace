  "welcomeTitle": {
    "message": "Spam Trace is installed"
  },
  "welcomeIntro": {
    "message": "Trace the origins of spam emails on a map. Spam Trace analyzes message headers to estimate spam/phishing risk, shows the reasons and delivery route — fully offline by default."
  },
  "welcomePrivacyHead": {
    "message": "About the “Read your email messages” permission"
  },
  "welcomePrivacy": {
    "message": "Thunderbird shows this permission for any add-on that can read mail. Spam Trace analyzes the message headers, and reads the body only to check links (for phishing) and to compute a hash. Your message subject and body text are never stored or sent — only hashes are kept, on your computer."
  },
  "welcomeOffline": {
    "message": "Online lookups (detailed geolocation, Tor check, statistics upload) are OFF by default. Each asks for its own permission when you turn it on in Options."
  },
  "welcomeOpenOptions": {
    "message": "Open settings"
  },
  "welcomeTag": {
    "message": "Email header analysis · offline by default"
  },
  "welcomeUseHead": {
    "message": "How to use"
  },
  "welcomeUse1": {
    "message": "Open a message, then click the Spam Trace button in the message toolbar to see its risk score, the reasons, and the delivery route map."
  },
  "welcomeUse2": {
    "message": "Click “Suspicious Email” (which also sets Thunderbird’s Junk flag) or “Legitimate” — Spam Trace learns from your feedback to refine future scores."
  },
  "welcomeUse3": {
    "message": "High-risk messages can pop up an alert window automatically (you can set the threshold in Settings)."
  },
  "welcomeAnalyzeHead": {
    "message": "What it checks"
  },
  "welcomeAnalyze": {
    "message": "The Received route and sender IP/ASN/country, SPF/DKIM/DMARC authentication, links in the body (comparing the sender domain with link domains), and brand-impersonation patterns — summarized as a 0–100 score with the reasons and a route map."
  },
  "welcomeOnlineHead": {
    "message": "Online features are optional"
  },
  "welcomeData": {
    "message": "IP-to-country uses a bundled DB-IP database (CC BY 4.0); the world map uses Natural Earth (public domain). Both are included in the add-on and used offline. The interface is available in English, Japanese, Chinese (Simplified), Spanish, German, and French."
  },
